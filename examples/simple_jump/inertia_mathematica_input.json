{
  "version": 1,
  "name": "inertia-threshold-smoke",
  "slot_indexing": "1_based",
  "n": 1,
  "arrays": {
    "imux": [0.0],
    "imuz": [0.91],
    "mmu": [0.001]
  },
  "inertia_events": [
    {
      "id": "x_inertia_hit_slot_1",
      "type": "hit",
      "axis": "x",
      "slot": 1,
      "retention_multiplier": 0.91,
      "threshold": 0.005,
      "reason": "X velocity is small enough to be thresholded, so imux[1] is zeroed."
    },
    {
      "id": "z_inertia_avoid_slot_1",
      "type": "avoid",
      "axis": "z",
      "direction": "positive",
      "slot": 1,
      "retention_multiplier": 0.91,
      "threshold": 0.0005,
      "reason": "Z velocity must remain above the threshold."
    }
  ],
  "objective": {
    "sense": "maximize",
    "expression": "Z[F, 1]"
  },
  "constraints": [],
  "optimizer": {
    "accuracy_goal": 20,
    "precision_goal": 20
  }
}
