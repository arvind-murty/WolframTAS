{
  "version": 1,
  "name": "block_route_simple",
  "defaults": {
    "run_ticks": 0
  },
  "landing_blocks": [
    {
      "kind": "landing",
      "id": "start",
      "x": 0,
      "y": 64,
      "z": 0,
      "width": 1,
      "length": 1
    },
    {
      "kind": "landing",
      "id": "finish",
      "x": 0,
      "y": 64,
      "z": 3,
      "width": 1,
      "length": 1
    }
  ],
  "objective": {
    "axis": "z",
    "sense": "maximize"
  },
  "candidate_selection": {
    "max_precise_candidates": 1,
    "objective_margin": 0.0,
    "coarse_tolerance": 0.03,
    "coarse_optimizer": {
      "method": "NelderMead",
      "accuracy_goal": 3,
      "precision_goal": 3,
      "max_iterations": 300
    }
  },
  "solver": {
    "default_relaxed_tolerance": 0.0,
    "solution_tolerance": 0.001
  }
}
