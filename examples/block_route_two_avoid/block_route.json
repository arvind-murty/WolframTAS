{
  "version": 1,
  "name": "block_route_two_avoid",
  "defaults": {
    "run_ticks": 0
  },
  "landing_blocks": [
    {
      "id": "start",
      "x": 0,
      "y": 64,
      "z": 0,
      "width": 1,
      "length": 1,
      "run_ticks": 1
    },
    {
      "id": "middle",
      "x": 0,
      "y": 65,
      "z": 2.5,
      "width": 1,
      "length": 1
    },
    {
      "id": "finish",
      "x": 0,
      "y": 64,
      "z": 6,
      "width": 1,
      "length": 1
    }
  ],
  "avoid_blocks": [
    {
      "id": "center_post",
      "x": 0,
      "y": 66,
      "z": 4,
      "width": 1,
      "length": 1,
      "height": 1,
      "between": ["middle", "finish"],
      "corner_hints": ["north_west"]
    },
    {
      "id": "east_post",
      "x": 2,
      "y": 66,
      "z": 4,
      "width": 1,
      "length": 1,
      "height": 1,
      "between": ["middle", "finish"],
      "corner_hints": ["west"]
    }
  ],
  "candidate_selection": {
    "max_generated_candidates": 1,
    "max_precise_candidates": 1,
    "objective_margin": 0,
    "coarse_tolerance": 0.03,
    "wolfram_timeout": 60,
    "coarse_optimizer": {
      "method": "NelderMead",
      "accuracy_goal": 3,
      "precision_goal": 3,
      "max_iterations": 300
    }
  },
  "objective": {
    "axis": "z",
    "sense": "maximize"
  },
  "solver": {
    "default_relaxed_tolerance": 0.0,
    "solution_tolerance": 0.001
  }
}
