{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolframtas.local/schemas/exact_solver_input.schema.json",
  "title": "WolframTAS Exact Solver Input",
  "type": "object",
  "required": ["version", "slot_indexing", "n", "angle_domain", "movement_plan", "optimal_solution"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "slot_indexing": { "type": "string", "const": "1_based" },
    "n": { "type": "integer", "minimum": 1 },
    "angle_domain": {
      "type": "object",
      "required": ["table_size"],
      "properties": {
        "table_size": { "type": "integer", "const": 65536 }
      },
      "additionalProperties": false
    },
    "initial_state": { "$ref": "#/$defs/player_state" },
    "movement_plan": { "$ref": "movement_plan.schema.json" },
    "derived_model": {
      "type": "object",
      "properties": {
        "arrays": { "$ref": "#/$defs/arrays" },
        "component_overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/component_override" }
        },
        "inertia_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/inertia_event" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/exact_constraint" }
        },
        "diagnostics": { "type": "object" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_constraint" }
    },
    "exact_objective": {
      "type": "object",
      "required": ["type", "axis", "slot"],
      "properties": {
        "type": { "type": "string", "enum": ["position"] },
        "axis": { "type": "string", "enum": ["x", "z"] },
        "slot": { "type": "integer", "minimum": 0 },
        "target_value": { "type": "number" },
        "solution_tolerance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "exact_solver": {
      "type": "object",
      "properties": {
        "max_repair_iterations": { "type": "integer", "minimum": 0 },
        "max_candidate_evaluations": { "type": "integer", "minimum": 0 },
        "top_k_moves": { "type": "integer", "minimum": 1 },
        "max_index_delta_per_iteration": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "optimal_solution": {
      "type": "object",
      "required": ["status", "objective_value", "movement_directions"],
      "properties": {
        "status": { "type": "string", "enum": ["optimal", "feasible"] },
        "objective_value": { "type": "number" },
        "movement_directions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/movement_direction" }
        },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "diagnostics": { "type": "object" }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "number_array": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "arrays": {
      "type": "object",
      "required": ["imux", "imuz", "mmu"],
      "properties": {
        "imux": { "$ref": "#/$defs/number_array" },
        "imuz": { "$ref": "#/$defs/number_array" },
        "mmu": { "$ref": "#/$defs/number_array" }
      },
      "additionalProperties": false
    },
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "player_state": {
      "type": "object",
      "required": ["position", "velocity"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "velocity": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "on_ground": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "component_override": {
      "type": "object",
      "required": ["target", "slot", "value"],
      "properties": {
        "target": { "type": "string", "enum": ["mmux", "mmuz"] },
        "slot": { "type": "integer", "minimum": 1 },
        "value": { "type": "number" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inertia_event": {
      "type": "object",
      "required": ["id", "type", "axis", "slot", "retention_multiplier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["hit", "avoid"] },
        "axis": { "type": "string", "enum": ["x", "z"] },
        "direction": { "type": "string", "enum": ["positive", "negative"] },
        "slot": { "type": "integer", "minimum": 1 },
        "retention_multiplier": { "type": "number" },
        "threshold": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exact_constraint": {
      "type": "object",
      "required": ["id", "type", "slot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["position_bounds"] },
        "slot": { "type": "integer", "minimum": 0 },
        "min_x": { "type": "number" },
        "max_x": { "type": "number" },
        "min_z": { "type": "number" },
        "max_z": { "type": "number" },
        "mathematica_tolerance": { "type": "number", "minimum": 0 },
        "exact_tolerance": { "type": "number", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "movement_direction": {
      "type": "object",
      "required": ["slot", "radians"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1 },
        "radians": { "type": "number" },
        "degrees": { "type": "number" }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["slot", "x", "z"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "world_x": { "type": "number" },
        "world_z": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
