{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolframtas.local/schemas/optimization_request.schema.json",
  "title": "WolframTAS Optimization Request",
  "type": "object",
  "required": [
    "version",
    "minecraft_version",
    "slot_indexing",
    "n",
    "angle_domain",
    "initial_state",
    "movement_plan",
    "constraints",
    "exact_objective",
    "solver"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "minecraft_version": { "type": "string", "const": "1.8.9" },
    "name": { "type": "string" },
    "slot_indexing": { "type": "string", "const": "1_based" },
    "n": { "type": "integer", "minimum": 1 },
    "angle_domain": {
      "type": "object",
      "required": ["table_size"],
      "properties": {
        "table_size": { "type": "integer", "const": 65536 }
      },
      "additionalProperties": false
    },
    "initial_state": { "$ref": "#/$defs/player_state" },
    "movement_plan": { "$ref": "movement_plan.schema.json" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_constraint" }
    },
    "inertia_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/inertia_event" }
    },
    "exact_objective": {
      "type": "object",
      "required": ["type", "axis", "slot"],
      "properties": {
        "type": { "type": "string", "enum": ["position"] },
        "axis": { "type": "string", "enum": ["x", "z"] },
        "slot": { "type": "integer", "minimum": 0 },
        "target_value": { "type": "number" },
        "solution_tolerance": { "type": "number", "minimum": 0 },
        "sense": { "type": "string", "enum": ["maximize", "minimize"] },
        "expression": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "solver": {
      "type": "object",
      "properties": {
        "solution_tolerance": { "type": "number", "minimum": 0 },
        "default_relaxed_tolerance": { "type": "number", "minimum": 0 },
        "max_repair_iterations": { "type": "integer", "minimum": 0 },
        "max_candidate_evaluations": { "type": "integer", "minimum": 0 },
        "top_k_moves": { "type": "integer", "minimum": 1 },
        "max_index_delta_per_iteration": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "player_state": {
      "type": "object",
      "required": ["position", "velocity"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "velocity": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "on_ground": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "exact_constraint": {
      "type": "object",
      "required": ["id", "type", "slot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["position_bounds"] },
        "slot": { "type": "integer", "minimum": 0 },
        "min_x": { "type": "number" },
        "max_x": { "type": "number" },
        "min_z": { "type": "number" },
        "max_z": { "type": "number" },
        "mathematica_tolerance": { "type": "number", "minimum": 0 },
        "exact_tolerance": { "type": "number", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inertia_event": {
      "type": "object",
      "required": ["id", "type", "axis", "slot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["hit", "avoid"] },
        "axis": { "type": "string", "enum": ["x", "z"] },
        "direction": { "type": "string", "enum": ["positive", "negative"] },
        "slot": { "type": "integer", "minimum": 1 },
        "threshold": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
