{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolframtas.local/schemas/exact_solution.schema.json",
  "title": "WolframTAS Exact Solution",
  "type": "object",
  "required": ["version", "status", "angles_discrete", "states_exact", "macro_rows", "diagnostics"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["solved", "failed", "error"] },
    "angles_discrete": {
      "type": "array",
      "items": { "$ref": "#/$defs/discrete_angle" }
    },
    "states_exact": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_state" }
    },
    "macro_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/macro_row" }
    },
    "derived_model": { "$ref": "#/$defs/derived_model" },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3_string": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "string" },
        "y": { "type": "string" },
        "z": { "type": "string" }
      },
      "additionalProperties": false
    },
    "discrete_angle": {
      "type": "object",
      "required": ["tick", "yaw_index", "pitch_index", "yaw_degrees", "pitch_degrees"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "yaw_index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "pitch_index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "yaw_degrees": { "type": "number" },
        "pitch_degrees": { "type": "number" }
      },
      "additionalProperties": false
    },
    "exact_state": {
      "type": "object",
      "required": ["tick", "position", "velocity", "on_ground"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "position": { "$ref": "#/$defs/vec3_string" },
        "velocity": { "$ref": "#/$defs/vec3_string" },
        "on_ground": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "macro_row": {
      "type": "object",
      "required": ["w", "a", "s", "d", "p", "n", "j", "yaw", "pitch", "l", "r", "count"],
      "properties": {
        "w": { "type": "boolean" },
        "a": { "type": "boolean" },
        "s": { "type": "boolean" },
        "d": { "type": "boolean" },
        "p": { "type": "boolean" },
        "n": { "type": "boolean" },
        "j": { "type": "boolean" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "l": { "type": "integer", "minimum": 0 },
        "r": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "derived_model": {
      "type": "object",
      "description": "Movement values the exact solver derived from movement_plan (imux/imuz retention and mmu acceleration per slot). Echoed for debugging and cross-model consistency checks against the Python orchestrator derivation.",
      "required": ["imux", "imuz", "mmu"],
      "properties": {
        "imux": { "type": "array", "items": { "type": "number" } },
        "imuz": { "type": "array", "items": { "type": "number" } },
        "mmu": { "type": "array", "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "changed_angle_index": {
      "type": "object",
      "required": ["slot", "from", "to", "delta"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1 },
        "from": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "to": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "delta": { "type": "integer", "minimum": -32768, "maximum": 32767 }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "mode",
        "state_count",
        "initial_residual_norm",
        "final_residual_norm",
        "worst_constraint_id",
        "candidate_evaluations",
        "repair_iterations",
        "exact_objective_value",
        "objective_deviation",
        "changed_angle_indices"
      ],
      "properties": {
        "mode": { "type": "string" },
        "state_count": { "type": "integer", "minimum": 1 },
        "initial_residual_norm": { "type": "string" },
        "final_residual_norm": { "type": "string" },
        "worst_constraint_id": { "type": "string" },
        "candidate_evaluations": { "type": "integer", "minimum": 0 },
        "repair_iterations": { "type": "integer", "minimum": 0 },
        "exact_objective_value": { "type": "string" },
        "objective_deviation": { "type": "string" },
        "changed_angle_indices": {
          "type": "array",
          "items": { "$ref": "#/$defs/changed_angle_index" }
        }
      },
      "additionalProperties": false
    }
  }
}
