{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolframtas.local/schemas/exact_solution.schema.json",
  "title": "WolframTAS Exact Solution",
  "type": "object",
  "required": ["version", "status", "angles_discrete", "states_exact", "macro_rows", "diagnostics"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["solved", "unsolved", "error"] },
    "angles_discrete": {
      "type": "array",
      "items": { "$ref": "#/$defs/discrete_angle" }
    },
    "states_exact": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_state" }
    },
    "macro_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/macro_row" }
    },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3_string": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "string" },
        "y": { "type": "string" },
        "z": { "type": "string" }
      },
      "additionalProperties": false
    },
    "discrete_angle": {
      "type": "object",
      "required": ["tick", "yaw_index", "pitch_index", "yaw_degrees", "pitch_degrees"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "yaw_index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "pitch_index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "yaw_degrees": { "type": "number" },
        "pitch_degrees": { "type": "number" }
      },
      "additionalProperties": false
    },
    "exact_state": {
      "type": "object",
      "required": ["tick", "position", "velocity", "on_ground"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "position": { "$ref": "#/$defs/vec3_string" },
        "velocity": { "$ref": "#/$defs/vec3_string" },
        "on_ground": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "macro_row": {
      "type": "object",
      "required": ["w", "a", "s", "d", "p", "n", "j", "yaw", "pitch", "l", "r", "count"],
      "properties": {
        "w": { "type": "boolean" },
        "a": { "type": "boolean" },
        "s": { "type": "boolean" },
        "d": { "type": "boolean" },
        "p": { "type": "boolean" },
        "n": { "type": "boolean" },
        "j": { "type": "boolean" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "l": { "type": "integer", "minimum": 0 },
        "r": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
