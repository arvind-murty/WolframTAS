{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolframtas.local/schemas/block_route_input.schema.json",
  "title": "WolframTAS Block Route Input",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "initial_yaw": { "type": "number" },
    "initial_pitch": { "type": "number" },
    "initial_position": { "$ref": "#/$defs/initial_position" },
    "initial_velocity": { "$ref": "#/$defs/initial_velocity" },
    "init_speed": { "type": "number" },
    "init_imux": { "type": "number" },
    "init_imuz": { "type": "number" },
    "defaults": {
      "type": "object",
      "properties": {
        "run_ticks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blocks": {
      "description": "Legacy alias for landing_blocks.",
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/landing_block" }
    },
    "landing_blocks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/landing_block" }
    },
    "avoid_blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/avoid_block" }
    },
    "candidate_selection": {
      "type": "object",
      "properties": {
        "max_generated_candidates": { "type": "integer", "minimum": 1 },
        "max_precise_candidates": { "type": "integer", "minimum": 1 },
        "objective_margin": { "type": "number", "minimum": 0 },
        "coarse_tolerance": { "type": "number", "minimum": 0 },
        "wolfram_timeout": { "type": "number", "exclusiveMinimum": 0 },
        "coarse_optimizer": {
          "type": "object",
          "properties": {
            "accuracy_goal": { "type": "integer", "minimum": 0 },
            "precision_goal": { "type": "integer", "minimum": 0 },
            "max_iterations": { "type": "integer", "minimum": 1 },
            "method": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "axis": { "type": "string", "enum": ["x", "z"] },
        "slot": { "type": "integer", "minimum": 0 },
        "sense": { "type": "string", "enum": ["maximize", "minimize"] },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "solver": { "type": "object" },
    "optimizer": { "type": "object" },
    "exact_solver": { "type": "object" }
  },
  "additionalProperties": false,
  "oneOf": [
    { "required": ["landing_blocks"], "not": { "required": ["blocks"] } },
    { "required": ["blocks"], "not": { "required": ["landing_blocks"] } }
  ],
  "$defs": {
    "initial_position": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "initial_velocity": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "landing_block": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "kind": { "type": "string", "const": "landing" },
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "run_ticks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "avoid_block": {
      "type": "object",
      "required": ["x", "y", "z", "between"],
      "properties": {
        "kind": { "type": "string", "const": "avoid" },
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "between": {
          "type": "array",
          "prefixItems": [{ "type": "string" }, { "type": "string" }],
          "minItems": 2,
          "maxItems": 2
        },
        "corner_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["north_west", "north_east", "south_west", "south_east", "north", "south", "west", "east"]
          }
        },
        "transition_tick_window": {
          "type": "array",
          "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    }
  }
}
